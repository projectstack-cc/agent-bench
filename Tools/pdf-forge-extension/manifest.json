{
  "manifest_version": 3,
  "name": "ForgeMark — PDF to Markdown",
  "version": "0.1.0",
  "description": "Convert any PDF to clean Markdown locally. Your files never leave your machine.",
  "permissions": ["contextMenus", "downloads", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ForgeMark"
  },
  "icons": {}
}
